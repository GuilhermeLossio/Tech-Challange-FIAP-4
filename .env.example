# Raw zone
RAW_LOCAL_DIR=data/raw
PROCESSED_LOCAL_DIR=data/processed
MODELS_DIR=models

# AWS / S3
AWS_REGION=us-east-1
S3_BUCKET_RAW=your-raw-bucket-name
S3_RAW_PREFIX=raw
S3_BUCKET_REFINED=your-refined-bucket-name
S3_REFINED_PREFIX=refined
S3_BUCKET_PROCESSED=your-processed-bucket-name
S3_PROCESSED_PREFIX=processed
S3_BUCKET_MODEL=your-model-bucket-name
S3_MODEL_PREFIX=model

# Optional: useful for LocalStack or MinIO
# AWS_ENDPOINT_URL=http://localhost:4566

# Athena
ATHENA_DATABASE=tech_challenge_phase4
ATHENA_WORKGROUP=primary
# Optional when the workgroup already defines a result location
# ATHENA_OUTPUT_S3_URI=s3://your-athena-results-bucket/path/

# IBM Quantum
# IBM_QUANTUM_API_TOKEN=your_ibm_quantum_api_token
# IBM_QUANTUM_INSTANCE=your_ibm_quantum_instance_or_crn

# Credentials can come from the environment, shared credentials file, IAM role,
# or any other mechanism supported by boto3.
